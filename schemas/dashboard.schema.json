{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/eng-pulse/dashboard.schema.json",
  "title": "eng-pulse dashboard data (PULSE_DATA)",
  "description": "The JSON Claude writes into the <script id=\"pulse-data\"> block of templates/dashboard.html. The template reads only this object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated_at",
    "company",
    "window",
    "summary",
    "projects",
    "flags",
    "people",
    "trend",
    "coverage_notes"
  ],
  "$defs": {
    "status": {
      "enum": [
        "red",
        "yellow",
        "green"
      ]
    },
    "severity": {
      "enum": [
        "red",
        "yellow"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "slack_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[UW][A-Z0-9]+$"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "slack_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slack_id": {
          "$ref": "#/$defs/slack_id"
        }
      }
    }
  },
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "company": {
      "type": "string",
      "minLength": 1
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "red",
        "yellow",
        "green"
      ],
      "properties": {
        "red": {
          "$ref": "#/$defs/count"
        },
        "yellow": {
          "$ref": "#/$defs/count"
        },
        "green": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "owner",
          "progress_pct",
          "epics",
          "flags"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "owner": {
            "$ref": "#/$defs/owner"
          },
          "progress_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "epics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "done",
                "total"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "done": {
                  "$ref": "#/$defs/count"
                },
                "total": {
                  "$ref": "#/$defs/count"
                }
              }
            }
          },
          "flags": {
            "description": "Ids of entries in the top-level flags array attached to this project.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "signal",
          "severity",
          "title",
          "url",
          "owner",
          "next_action",
          "inferred"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "signal": {
            "enum": [
              "stuck_pr",
              "stale_pr",
              "contested_pr",
              "idle_issue",
              "board_mismatch",
              "blocked",
              "overloaded",
              "forecast_risk",
              "health"
            ]
          },
          "severity": {
            "$ref": "#/$defs/severity"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "owner": {
            "$ref": "#/$defs/owner"
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          },
          "inferred": {
            "type": "boolean"
          }
        }
      }
    },
    "people": {
      "description": "Teams appear in team-map order (order of first appearance here); the template lists names alphabetically within a team. Never sorted by wip.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "slack_id",
          "team",
          "wip"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "slack_id": {
            "$ref": "#/$defs/slack_id"
          },
          "team": {
            "type": "string",
            "minLength": 1
          },
          "wip": {
            "$ref": "#/$defs/count"
          }
        }
      }
    },
    "trend": {
      "description": "Daily red/yellow flag counts from previous runs, oldest first (up to 14 points).",
      "type": "array",
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "red",
          "yellow"
        ],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "red": {
            "$ref": "#/$defs/count"
          },
          "yellow": {
            "$ref": "#/$defs/count"
          }
        }
      }
    },
    "coverage_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
